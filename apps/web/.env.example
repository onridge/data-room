# Base URL of the API. No trailing slash.
VITE_API_URL="http://localhost:3000"

# Google OAuth client ID for the Sign in with Google button.
# Must be the same value as the API's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=""

# Note: Vite inlines VITE_* variables into the bundle at build time, so
# these are public by design — never put a secret here. On Vercel they
# must be set before the build, and changing one requires a redeploy.
