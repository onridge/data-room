# PostgreSQL connection string used by Prisma.
# Local: point this at your own Postgres, or tunnel to a hosted one.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/data_room"

# Secret used to sign JWTs. The API refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=""

# Google OAuth client ID, used as the expected audience when verifying
# Google Sign-In tokens. Must be the same value as the frontend's
# VITE_GOOGLE_CLIENT_ID. Required for Google sign-in: the endpoint fails
# loudly without it rather than accepting a token minted for another app.
GOOGLE_CLIENT_ID=""

# Origin allowed by CORS — the URL the frontend is served from.
# Required: the API refuses to boot without it, rather than falling back to
# allowing every origin.
WEB_ORIGIN="http://localhost:5173"

# Read-write token for the Vercel Blob store that holds uploaded files.
# Vercel dashboard -> Storage -> your Blob store -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=""

# Public base URL of THIS api, so Vercel Blob knows where to send the
# "upload completed" callback. Required because the API is not hosted on
# Vercel: the SDK can only infer this URL when it detects a Vercel
# deployment, and silently skips the callback otherwise — which leaves
# every upload stuck in PENDING.
# Leave empty for local development (the callback cannot reach localhost).
VERCEL_BLOB_CALLBACK_URL=""

# Optional. The host platform normally sets this; defaults to 3000.
# PORT=3000
