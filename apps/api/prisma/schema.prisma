// Pinned to Prisma 6 (not 7): the v7 "prisma-client" generator emits
// import.meta.url in its output, which breaks under Nest's CommonJS build
// (Node loads the file as ESM, then chokes on the CJS `exports` in the same
// file). Classic prisma-client-js has no such issue. See migration
// 20260819000000_add_google_auth for the schema change that shipped
// alongside this downgrade.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShareResourceType {
  DATA_ROOM
  FOLDER
  FILE
}

enum ShareMode {
  PUBLIC
  PERMISSIONED
}

enum ShareRole {
  VIEWER
  EDITOR
}

enum FileStatus {
  PENDING
  READY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Null for accounts created via Google — they never set a password.
  passwordHash String?
  // Set only for accounts created (or later linked) via Google Sign-In.
  googleId     String?  @unique
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dataRooms     DataRoom[]
  folders       Folder[]
  files         File[]
  fileVersions  FileVersion[]
  sharesCreated Share[]      @relation("ShareCreatedBy")
  shareGrants   ShareGrant[]

  @@map("users")
}

model DataRoom {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folders Folder[]
  files   File[]

  @@index([ownerId])
  @@map("data_rooms")
}

// Adjacency-list tree: parentId = null means the folder sits at the
// data room root. See README "How it scales" for the closure-table
// alternative once subtree queries get hot at large fan-out.
model Folder {
  id          String   @id @default(uuid())
  name        String
  dataRoomId  String
  dataRoom    DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderChildren")
  createdById String
  // Cascade (not the default RESTRICT): createdById always equals the data
  // room's owner today, so this row is already gone via the DataRoom
  // cascade by the time a User delete reaches here. Leaving it RESTRICT
  // makes Postgres's constraint-check order race that cascade and fail.
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files File[]

  // Name must be unique among siblings within the same data room. Postgres
  // doesn't treat two NULLs as equal, so this alone doesn't catch conflicts
  // between two root-level folders (parentId = NULL) — see the hand-written
  // partial unique index in migration 20260819130000_root_level_unique_names.
  @@unique([dataRoomId, parentId, name])
  @@index([dataRoomId, parentId])
  @@map("folders")
}

// A File is the logical document — a name in a folder. Its bytes live in
// FileVersion, so re-uploading under an existing name adds a version
// instead of silently becoming "Report (1).pdf".
model File {
  id          String   @id @default(uuid())
  name        String
  dataRoomId  String
  dataRoom    DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  // null folderId = file lives at the data room root, alongside top-level folders.
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions FileVersion[] @relation("FileVersions")

  // Denormalised pointer to the version that listings, downloads and shares
  // resolve to. It could be derived as "highest versionNumber that is
  // READY", but that turns every listing into a correlated subquery — and
  // this also makes "current" an explicit decision, which is what a future
  // restore-this-version action would flip.
  // Stays null until the first upload is confirmed, which is what keeps a
  // half-uploaded file out of listings.
  currentVersionId String?      @unique
  currentVersion   FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  // Same NULL-vs-NULL caveat as Folder — see the partial unique index in
  // migration 20260819130000_root_level_unique_names for root-level files.
  @@unique([dataRoomId, folderId, name])
  @@index([dataRoomId, folderId])
  @@map("files")
}

model FileVersion {
  id            String     @id @default(uuid())
  fileId        String
  file          File       @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  // 1-based and per file, so the UI can say "v3" without a lookup.
  versionNumber Int
  sizeBytes     BigInt
  mimeType      String
  storageKey    String     @unique
  uploadedById  String
  uploadedBy    User       @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  // Pending until Vercel confirms the upload finished; a version that never
  // completes is simply never promoted to current.
  status        FileStatus @default(PENDING)
  createdAt     DateTime   @default(now())

  currentOf File? @relation("CurrentVersion")

  @@unique([fileId, versionNumber])
  @@index([fileId])
  @@map("file_versions")
}

// Polymorphic target (resourceType + resourceId) instead of three nullable
// FKs so a Data Room, Folder, or File can all be shared through one model.
// Prisma can't enforce the FK for a polymorphic relation, so resourceId
// existence is validated in the service layer, not the database.
model Share {
  id           String            @id @default(uuid())
  resourceType ShareResourceType
  resourceId   String
  mode         ShareMode
  // Set only when mode = PUBLIC; the opaque value in the shareable link.
  token        String?           @unique
  createdById  String
  createdBy    User              @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  revokedAt    DateTime?

  grants ShareGrant[]

  @@index([resourceType, resourceId])
  @@map("shares")
}

// Only meaningful when the parent Share.mode = PERMISSIONED.
model ShareGrant {
  id        String    @id @default(uuid())
  shareId   String
  share     Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ShareRole @default(VIEWER)
  createdAt DateTime  @default(now())

  @@unique([shareId, userId])
  @@map("share_grants")
}
